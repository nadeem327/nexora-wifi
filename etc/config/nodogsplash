
config nodogsplash
	option enabled '1'
	option fwhook_enabled '1'
	option gatewayinterface 'br-hotspot'
	option gatewayname 'Nexora Free WiFi Hotspot'
	option maxclients '250'
	option preauthidletimeout '120'
	option authidletimeout '120'
	option sessiontimeout '2592000'
	option checkinterval '60'
	option binauth '/usr/bin/monthly_auth.sh'
	option force_valid_voucher '1'
	list users_to_router 'allow tcp port 22'
	list users_to_router 'allow tcp port 23'
