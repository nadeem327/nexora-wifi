config zone 'vpn_zone'
	option name 'vpn'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	option network 'vpn0'

config forwarding 'vpn_forwarding'
	option src 'lan'
	option dest 'vpn'

config rule
	option name 'Hotspot-DNS-Pihole'
	option src 'hotspot'
	option dest 'lan'
	option dest_ip '192.168.20.147'
	option dest_port '53'
	option proto 'tcp udp'
	option target 'ACCEPT'

