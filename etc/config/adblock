
config adblock 'global'
	option adb_enabled '1'
	option adb_debug '0'
	option adb_dnsforce '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '0'
	option adb_dns 'dnsmasq'
	option adb_fetchutil 'uclient-fetch'
	option adb_nicelimit '0'
	option adb_fetchcmd 'curl'
	list adb_utc_feed 'adult'
	option adb_lookupdomain 'google.com'
	list adb_feed 'adaway'
	list adb_feed 'adguard'
	list adb_feed 'adguard_tracking'
	list adb_feed 'bitcoin'
	list adb_feed 'certpl'
	list adb_feed 'games_tracking'
	list adb_feed 'yoyo'
	option adb_flush '0'

